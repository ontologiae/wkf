# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A flat DAG workflow engine whose nodes are registered handlers"
description:
  "wkf executes an acyclic, flat graph of nodes. A node is a call to a handler registered by the host; a node routes when its output names the next one. The engine owns no storage, no billing, no logging and no domain type: it consumes a graph that has already been read, carries an opaque context, and returns the trail of what it visited -- for a completed traversal as well as for an interrupted one. Acyclicity is checked when the graph is loaded (the refusal names the nodes of the cycle) and the most expensive path through the DAG can be computed before anything runs."
maintainer: ["Pierre-Alexandre Voye"]
authors: ["Pierre-Alexandre Voye"]
license: "MIT"
homepage: "https://github.com/ontologiae/ocaml_wkf"
bug-reports: "https://github.com/ontologiae/ocaml_wkf/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.5" & >= "3.5"}
  "lwt"
  "yojson"
  "atdgen-runtime"
  "atdgen" {>= "2.0" & build}
  "ocamlgraph" {>= "2.0"}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/ontologiae/ocaml_wkf.git"
