(** The registry: the base names, the code does.

    A node carries the {e name} of a handler; the engine looks that name up in
    a registry the host filled at startup. This is what stands in place of an
    expression language stored in the database: what is stored is a name and
    data, never code. A name is checked when the graph is loaded; an expression
    is only checked by running it, on a real traversal, at someone's expense.

    @canonical Wkf.Registry *)

type runner =
  context:Yojson.Safe.t -> trail:Trail.t -> (Yojson.Safe.t, string) result Lwt.t
(** A handler whose configuration has already been read. This is what the
    engine calls. *)

module type HANDLER = sig
  val name : string
  (** The name a node refers to. Unique within a registry. *)

  type config
  (** The type of this handler's configuration -- in practice, generated by
      atdgen from the handler's own [.atd]. That is what gives the JSON sitting
      in the database the validation a [jsonb] column does not have. *)

  val read_config : Yojson.Safe.t -> config
  (** Reads the node's configuration. It is expected to {e raise} on a
      malformed one, naming the offending field; the loader catches that and
      refuses the node, saying which. See {!of_string_reader} for plugging an
      atdgen-generated [..._of_string] in here.

      It is called once per node, when the graph is loaded -- never during a
      traversal. *)

  val run :
    config:config ->
    context:Yojson.Safe.t ->
    trail:Trail.t ->
    (Yojson.Safe.t, string) result Lwt.t
  (** The work itself.

      [context] is built by the host and passed through untouched: the engine
      does not read it, complete it or validate it. That is deliberate, and it
      is what keeps the engine generic -- a context typed by the engine would
      force the engine to know what the application puts in it. The price is
      that the engine can guarantee nothing about the context; each handler
      guarantees what concerns it.

      [trail] is the other channel, and it is the engine's own: what the nodes
      visited so far in this traversal returned, in order, never including
      this node itself since it has not returned yet. A node that computes a
      value the rest of the traversal must use -- not just where to go --
      reaches it with {!Trail.output}[ trail "some_earlier_node"]; [context]
      cannot carry that, since it is fixed before the traversal starts and the
      earlier node's output does not exist yet at that point.

      The returned JSON is free, except for three reserved fields:

      - ["next"]: a node name, or [`Null] to end the traversal here. This is
        all there is to routing: a node routes when its output names the next
        one.
      - ["price"]: an integer the engine carries and hands back. The first node
        that posts one fixes it; a later node may only {e lower} it.
      - ["failure"]: a message. Returning it is the same as returning
        [Error msg] -- it is there for a handler that wants to report a failure
        alongside other fields.

      Everything else is opaque to the engine and kept in the trail. *)
end

type t
(** A registry. Create one per process, or take {!default}. *)

val create : unit -> t
val default : t

exception Duplicate of string
(** Raised by {!register} when a name is already taken. Replacing a handler
    behind the back of the graph that names it is exactly the "what is written
    is not what runs" hazard this module exists to prevent; {!replace} is there
    for when it is meant. *)

val register : ?registry:t -> (module HANDLER) -> unit
val replace : ?registry:t -> (module HANDLER) -> unit
val mem : ?registry:t -> string -> bool
val names : ?registry:t -> unit -> string list

val prepare : ?registry:t -> string -> Yojson.Safe.t -> (runner, string) result
(** [prepare name config] finds the handler and has it read [config], yielding
    the runner the engine will call. [Error] if the name is unknown or the
    configuration was refused -- in both cases the message names what went
    wrong. This is what {!Wkf.Loaded.of_graph} calls for every node. *)

val of_string_reader : (string -> 'a) -> Yojson.Safe.t -> 'a
(** [of_string_reader Mycfg_j.config_of_string] is a {!HANDLER.read_config}.
    The one-line adapter for an atdgen-generated reader. *)
